@inproceedings{10.5555/3277203.3277206,
author = {Soltan, Saleh and Mittal, Prateek and Poor, H. Vincent},
title = {BlackIoT: IoT Botnet of high wattage devices can disrupt the power grid},
year = {2018},
isbn = {9781931971461},
publisher = {USENIX Association},
address = {USA},
abstract = {We demonstrate that an Internet of Things (IoT) botnet of high wattage devices-such as air conditioners and heaters-gives a unique ability to adversaries to launch large-scale coordinated attacks on the power grid. In particular, we reveal a new class of potential attacks on power grids called the Manipulation of demand via IoT (MadIoT) attacks that can leverage such a botnet in order to manipulate the power demand in the grid. We study five variations of the MadloT attacks and evaluate their effectiveness via state-of-the-art simulators on real-world power grid models. These simulation results demonstrate that the MadIoT attacks can result in local power outages and in the worst cases, large-scale blackouts. Moreover, we show that these attacks can rather be used to increase the operating cost of the grid to benefit a few utilities in the electricity market. This work sheds light upon the interdependency between the vulnerability of the IoT and that of the other networks such as the power grid whose security requires attention from both the systems security and power engineering communities.},
booktitle = {Proceedings of the 27th USENIX Conference on Security Symposium},
pages = {15–32},
numpages = {18},
location = {Baltimore, MD, USA},
series = {SEC'18}
}

